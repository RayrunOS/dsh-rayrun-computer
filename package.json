{
  "name": "dsh-rayrun-computer",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RayrunOS/dsh-rayrun-computer.git"
  },
  "homepage": "https://github.com/RayrunOS/dsh-rayrun-computer",
  "type": "module",
  "description": "Rayrun cloud computers inside DeepSeek Harness: create, manage and open remote Linux desktops (noVNC) from the sidebar, and let the agent run commands, move files and delegate whole tasks on the same machines via rayrun_* tools. Switch per-session between cloud and local; password or WeChat login, token stored in the Harness vault.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
