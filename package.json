{
  "name": "dsh-rayrun-computer",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RayrunOS/dsh-rayrun-computer.git"
  },
  "homepage": "https://github.com/RayrunOS/dsh-rayrun-computer",
  "type": "module",
  "description": "Rayrun cloud computers for DeepSeek Harness (DSH): a Linux cloud computer in the sidebar with a noVNC desktop, an agent sandbox, rayrun_* tools for commands, files and whole-task delegation, and per-session cloud/local routing. 云电脑 / remote desktop; the token stays in the Harness vault.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cloud-computer",
    "云电脑",
    "remote-desktop",
    "novnc",
    "sandbox",
    "linux",
    "agent",
    "virtual-machine",
    "rayrun"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
